# NAM v2 backend configuration. Export variables before launch; .env is not loaded automatically.
NAM_PORT=8000
NAM_DATA_DIR=data
NAM_DB_PATH=data/nam.db
NAM_TILE_CACHE_DIR=data/cache/tiles
NAM_TILE_TTL_HOURS=24

# Upstream connectors. 0 = fully offline (honest degradation), 1 = allow fetch.
NAM_ALLOW_UPSTREAM=1

# Optional tile URL templates (verified at connector time; see /connectors/status)
NAM_CTX_TILE_TEMPLATE=https://murray-lab.caltech.edu/CTX/V01/TileData/Z{z}/{y}_{x}.jpg

# JEV local LLM (Ollama OpenAI-compatible API). Set NAM_LLM_BASE_URL= to disable.
NAM_LLM_BASE_URL=http://127.0.0.1:11434/v1
NAM_LLM_MODEL=qwen2.5:1.5b

# Optional security settings (empty NAM_API_KEY = open local dev mode)
NAM_API_KEY=
NAM_CORS_ORIGINS=*

