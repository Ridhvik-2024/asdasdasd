# NAM v2 backend configuration (copy to .env or export)
NAM_PORT=8000
NAM_DATA_DIR=data
NAM_DB_PATH=data/nam.db
NAM_TILE_CACHE_DIR=data/cache/tiles
NAM_TILE_TTL_HOURS=24

# Upstream connectors. 0 = fully offline (honest degradation), 1 = allow fetch.
NAM_ALLOW_UPSTREAM=1

# Optional tile URL templates (verified at connector time; see /connectors/status)
NAM_CTX_TILE_TEMPLATE=https://murray-lab.caltech.edu/CTX/V01/TileData/Z{z}/{y}_{x}.jpg

# JEV local LLM (llama.cpp server, OpenAI-compatible). Empty = deterministic router.
NAM_LLM_BASE_URL=
NAM_LLM_MODEL=
